<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter withdrawal amount (KSh):"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"
        tools:ignore="HardcodedText"/>

    <EditText
        android:id="@+id/withdrawAmount"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Amount"
        android:inputType="numberDecimal"
        android:background="@drawable/bg_pill_input"
        android:backgroundTint="#F3F4F6"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#000000"
        android:textColorHint="#777777"
        android:layout_marginBottom="16dp"
        android:autofillHints="none"
        tools:ignore="HardcodedText"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm National ID Number:"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"
        tools:ignore="HardcodedText"/>

    <EditText
        android:id="@+id/withdrawIdConfirm"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="National ID"
        android:inputType="number"
        android:background="@drawable/bg_pill_input"
        android:backgroundTint="#F3F4F6"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#000000"
        android:textColorHint="#777777"
        android:autofillHints="none"
        tools:ignore="HardcodedText"/>

</LinearLayout>
