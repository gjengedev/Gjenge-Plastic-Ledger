<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- BACK BUTTON & TITLE -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="25dp">
                <ImageButton
                    android:id="@+id/backBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#FFFFFF"
                    android:contentDescription="Back"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_settings"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>

            <!-- PROFILE PIC & BASIC INFO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:cardCornerRadius="50dp"
                android:layout_marginBottom="16dp">
                <ImageView
                    android:id="@+id/profileImageLarge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/male_placeholder"
                    android:contentDescription="Profile Picture"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/profileNameLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Collector Name"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/gjengeIdLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPL-XXXXXX"
                android:textColor="#BBDEFB"
                android:textSize="14sp"
                android:layout_marginBottom="25dp"
                tools:ignore="HardcodedText"/>

            <!-- EDIT INFORMATION CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                android:backgroundTint="#FFFFFF"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_profile"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginBottom="16dp"/>

                    <EditText
                        android:id="@+id/nationalIdInput"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="@string/national_id_hint"
                        android:textColorHint="#000000"
                        android:textColor="#000000"
                        android:inputType="number"
                        android:background="@drawable/bg_pill_input"
                        android:backgroundTint="#F3F4F6"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:layout_marginBottom="12dp"
                        android:autofillHints="none"/>

                    <EditText
                        android:id="@+id/locationInput"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="@string/current_location_hint"
                        android:textColorHint="#000000"
                        android:textColor="#000000"
                        android:inputType="text"
                        android:background="@drawable/bg_pill_input"
                        android:backgroundTint="#F3F4F6"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:layout_marginBottom="12dp"
                        android:autofillHints="none"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_gender"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <Spinner
                        android:id="@+id/genderSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_spinner_pill"
                        android:backgroundTint="#F3F4F6"
                        android:popupBackground="#FFFFFF"
                        android:layout_marginBottom="20dp"/>

                    <!-- ID UPLOAD SECTION -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verify Identity (Mandatory for Withdrawals)"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginBottom="8dp"
                        tools:ignore="HardcodedText"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:id="@+id/btnUploadFront"
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_input"
                            android:backgroundTint="#F3F4F6"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <ImageView
                                android:id="@+id/idFrontImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerInside"
                                android:src="@android:drawable/ic_menu_camera"
                                app:tint="#777777"
                                android:contentDescription="@string/upload_id_front"/>
                            <TextView
                                android:id="@+id/txtFront"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/upload_id_front"
                                android:textSize="10sp"
                                android:textColor="#777777"
                                android:layout_marginTop="4dp"
                                tools:ignore="SmallSp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnUploadBack"
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_input"
                            android:backgroundTint="#F3F4F6"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">
                            <ImageView
                                android:id="@+id/idBackImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerInside"
                                android:src="@android:drawable/ic_menu_camera"
                                app:tint="#777777"
                                android:contentDescription="@string/upload_id_back"/>
                            <TextView
                                android:id="@+id/txtBack"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/upload_id_back"
                                android:textSize="10sp"
                                android:textColor="#777777"
                                android:layout_marginTop="4dp"
                                tools:ignore="SmallSp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/saveProfileBtn"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="@string/save_changes"
                        android:backgroundTint="#22C55E"
                        app:cornerRadius="28dp"
                        android:textAllCaps="false"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>



</RelativeLayout>
